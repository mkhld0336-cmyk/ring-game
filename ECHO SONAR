let c=document.querySelector('#c'),g=c.getContext('2d'),W,H,p,goal,walls,waves,reveal,score=0,energy=100,alive=true,last=0,drag=false;
function size(){let r=c.getBoundingClientRect();W=r.width;H=r.height;c.width=W*devicePixelRatio;c.height=H*devicePixelRatio;g.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0)}onresize=size;size();
function reset(){p={x:24,y:H/2,r:7};goal={x:W-25,y:H/2,r:11};walls=[{x:W*.2,y:0,w:10,h:H*.34},{x:W*.2,y:H*.55,w:10,h:H*.45},{x:W*.42,y:H*.24,w:10,h:H*.76},{x:W*.63,y:0,w:10,h:H*.4},{x:W*.63,y:H*.61,w:10,h:H*.39},{x:W*.82,y:H*.38,w:10,h:H*.43}];waves=[];reveal=walls.map(()=>0);score=0;energy=100;alive=true;submitted=false;last=performance.now();$('submitStatus').classList.remove('show');$('msg').textContent=t('msgStart');requestAnimationFrame(loop);ping()}
function ping(){if(!alive||energy<15)return;energy-=15;waves.push({x:p.x,y:p.y,r:0,life:1.2});reveal=reveal.map(()=>1.2);$('energy').textContent=Math.round(energy)+'%'}
$('ping').onclick=ping;$('restart').onclick=reset;
function pos(e){let r=c.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}}
c.onpointerdown=e=>{drag=true;c.setPointerCapture(e.pointerId);let q=pos(e);if(Math.hypot(q.x-p.x,q.y-p.y)>35)ping();else{p.x=q.x;p.y=q.y}};
c.onpointermove=e=>{if(drag&&alive){let q=pos(e);p.x=Math.max(7,Math.min(W-7,q.x));p.y=Math.max(7,Math.min(H-7,q.y))}};
c.onpointerup=()=>drag=false;
function loop(now){let dt=Math.min((now-last)/1000,.04);last=now;g.clearRect(0,0,W,H);g.fillStyle='#02030a';g.fillRect(0,0,W,H);
waves.forEach(a=>{a.r+=220*dt;a.life-=dt;g.strokeStyle=`rgba(65,245,255,${Math.max(0,a.life/1.2)*.8})`;g.lineWidth=2;g.beginPath();g.arc(a.x,a.y,a.r,0,7);g.stroke()});
waves=waves.filter(a=>a.life>0);reveal=reveal.map(v=>Math.max(0,v-dt));
walls.forEach((a,i)=>{if(reveal[i]>0){g.globalAlpha=Math.min(1,reveal[i]);g.shadowBlur=12;g.shadowColor='#41f5ff';g.fillStyle='#41f5ff';g.fillRect(a.x,a.y,a.w,a.h);g.globalAlpha=1;g.shadowBlur=0}});
g.fillStyle='#d2ff4d';g.shadowBlur=16;g.shadowColor='#d2ff4d';g.beginPath();g.arc(goal.x,goal.y,goal.r,0,7);g.fill();
g.fillStyle='#ff3bd4';g.shadowColor='#ff3bd4';g.beginPath();g.arc(p.x,p.y,p.r,0,7);g.fill();g.shadowBlur=0;
if(alive){score+=dt*3;$('score').textContent=Math.floor(score);energy=Math.min(100,energy+dt*2);$('energy').textContent=Math.round(energy)+'%';
walls.forEach((a,i)=>{if(reveal[i]>0&&p.x+p.r>a.x&&p.x-p.r<a.x+a.w&&p.y+p.r>a.y&&p.y-p.r<a.y+a.h){alive=false;$('msg').textContent=t('msgDead');triggerSubmit(Math.floor(score))}});
if(Math.hypot(p.x-goal.x,p.y-goal.y)<goal.r+p.r){alive=false;$('msg').textContent=t('msgWin');triggerSubmit(Math.floor(score)+50)}}
requestAnimationFrame(loop)}
document.documentElement.lang=L;document.documentElement.dir=RTL.includes(L)?'rtl':'ltr';applyT();reset();
})();
</script></html>
